{
  "$schema": "../schemas/design-tokens.schema.json",
  "version": "1.1.0",
  "source": "HouseNet first-party logo and website CSS; presentation rules in docs/DESIGN-LANGUAGE.md",
  "color": {
    "primary": {
      "value": "#E4003A",
      "role": "authority"
    },
    "secondary": {
      "value": "#1C2125",
      "role": "control surface"
    },
    "accent": {
      "value": "#A9143D",
      "role": "secondary emphasis"
    },
    "dark-background": {
      "value": "#1C2125",
      "role": "dark canvas"
    },
    "light-background": {
      "value": "#F6F9FB",
      "role": "light canvas"
    },
    "foreground": {
      "value": "#1D1D1B",
      "role": "primary text"
    },
    "muted": {
      "value": "#6F6F6E",
      "role": "secondary text"
    },
    "surface": {
      "value": "#EDF3F6",
      "role": "quiet surface"
    },
    "border": {
      "value": "#D1DCE2",
      "role": "structure"
    },
    "success": {
      "value": "#78AD57",
      "role": "active state"
    },
    "warning": {
      "value": "#A9143D",
      "role": "warning state"
    },
    "critical": {
      "value": "#E4003A",
      "role": "critical state"
    }
  },
  "typography": {
    "font-family-sans": {
      "value": "Inter, Noto Sans Armenian, Arial, sans-serif"
    },
    "font-family-mono": {
      "value": "ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "display-size": {
      "value": "clamp(2rem, 5vw, 3.25rem)"
    },
    "body-size": {
      "value": "1rem"
    },
    "small-size": {
      "value": "0.875rem"
    },
    "line-height": {
      "value": 1.5
    },
    "title-size": {
      "value": "1.5rem"
    },
    "caption-size": {
      "value": "0.75rem"
    },
    "heading-line-height": {
      "value": 1.15
    }
  },
  "space": {
    "1": {
      "value": "0.25rem"
    },
    "2": {
      "value": "0.5rem"
    },
    "3": {
      "value": "0.75rem"
    },
    "4": {
      "value": "1rem"
    },
    "6": {
      "value": "1.5rem"
    },
    "8": {
      "value": "2rem"
    },
    "12": {
      "value": "3rem"
    }
  },
  "radius": {
    "sm": {
      "value": "0.375rem"
    },
    "md": {
      "value": "0.75rem"
    },
    "lg": {
      "value": "1.25rem"
    }
  },
  "shadow": {
    "card": {
      "value": "0 8px 24px rgba(28,33,37,.10)"
    },
    "focus": {
      "value": "0 0 0 3px rgba(228,0,58,.28)"
    }
  },
  "status": {
    "active": {
      "color": "{color.success}"
    },
    "attention": {
      "color": "{color.warning}"
    },
    "blocked": {
      "color": "{color.critical}"
    }
  },
  "grid": {
    "columns": {
      "value": 12
    },
    "max-width": {
      "value": "1180px"
    },
    "gutter": {
      "value": "24px"
    },
    "breakpoint": {
      "value": "720px"
    }
  },
  "diagram": {
    "node-fill": {
      "value": "{color.surface}"
    },
    "node-border": {
      "value": "{color.border}"
    },
    "authority-fill": {
      "value": "{color.primary}"
    },
    "external-border": {
      "value": "{color.muted}"
    },
    "control-line": {
      "value": "{color.secondary}"
    },
    "reference-line": {
      "value": "{color.accent}"
    }
  },
  "chart": {
    "series-1": {
      "value": "{color.primary}"
    },
    "series-2": {
      "value": "{color.secondary}"
    },
    "series-3": {
      "value": "#5B7C99"
    },
    "series-4": {
      "value": "{color.success}"
    },
    "series-5": {
      "value": "#C98A2E"
    }
  }
}
