    {"path": "documents/templates/template-manifest.json", "kind": "json", "field": "version"},
    {"path": "documents/templates/powerpoint/executive.json", "kind": "json", "field": "version"},
    {"path": "documents/templates/excel/dashboard.json", "kind": "json", "field": "version"}
