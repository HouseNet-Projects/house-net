#!/usr/bin/env python3
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from versioning import manifest, check
root=Path(sys.argv[1]).resolve() if len(sys.argv)>1 else Path.cwd()
try:
    d=manifest(root); errors=check(root)
    if errors:
        print('FAIL — VERSION DRIFT'); print('\n'.join(errors)); raise SystemExit(1)
    print('PASS — version surfaces synchronized ('+d['version']+')')
except Exception as e:
    print('FAIL — '+str(e)); raise SystemExit(1)
