#!/usr/bin/env python3
"""Parse every Python source and YAML file; syntax-check workflow shell fragments."""
import ast
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode=True
root=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(root))
from housenet.control import load_yaml
count=0
for folder in ['housenet','tests','bin']:
    for p in (root/folder).rglob('*'):
        if p.is_file() and (p.suffix=='.py' or (folder=='bin' and p.read_bytes().startswith(b'#!/usr/bin/env python3'))):
            ast.parse(p.read_text(),filename=str(p));count+=1
for p in list((root/'.github/workflows').glob('*.yml'))+[root/'action.yml']:
    d=load_yaml(p)
    jobs=d.get('jobs',{})
    steps=d.get('runs',{}).get('steps',[])+[s for j in jobs.values() for s in j.get('steps',[])]
    for step in steps:
        if 'run' in step:
            subprocess.run(['bash','-n'],input=step['run'],text=True,check=True)
print('PASS Python, YAML and shell syntax:',count,'Python files')
