{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {"const": "HouseNet-Projects/house-net-control-plane"},
    "product": {"const": "HouseNet Control Plane"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "release_state": {"enum": ["active", "pre-release", "deprecated", "archived"]},
    "version_scheme": {"const": "semver"},
    "control_plane_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "schema_version": {"const": "1.0.0"},
    "version_surfaces": {"type": "array", "minItems": 1}
  },
  "required": ["repository", "product", "version", "release_state", "version_scheme", "control_plane_version", "schema_version", "version_surfaces"],
  "additionalProperties": false
}
