{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain", "owner", "status", "source", "sensitivity", "language", "last_verified"],
  "properties": {
    "id": {"type":"string", "pattern":"^HN-KNOW-[A-Z0-9-]+$"},
    "title": {"type":"string", "minLength":1},
    "domain": {"type":"string", "minLength":1},
    "owner": {"type":"string", "minLength":1},
    "status": {"enum":["canonical","draft","historical","archived","superseded"]},
    "source": {"type":"object", "additionalProperties":false, "required":["type","uri","hash"], "properties":{"type":{"enum":["repository","document","owner_statement","external"]},"uri":{"type":"string","minLength":1},"hash":{"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"}}},
    "effective_date": {"type":["string","null"]},
    "supersedes": {"type":["string","null"]},
    "superseded_by": {"type":["string","null"]},
    "sensitivity": {"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED","UNKNOWN"]},
    "language": {"type":"array", "items":{"enum":["en","hy"]}, "minItems":1, "uniqueItems":true},
    "last_verified": {"type":"string", "pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"}
  }
}
