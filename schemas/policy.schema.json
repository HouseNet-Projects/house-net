{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.3.0"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HN-[A-Z0-9-]+$"
          },
          "primitive": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "repository",
              "environment",
              "account",
              "control_plane"
            ]
          },
          "level": {
            "enum": [
              "MANDATORY",
              "RECOMMENDED",
              "REPO_SPECIFIC"
            ]
          },
          "applicability": {
            "type": "object",
            "properties": {
              "classes": {
                "type": "array",
                "items": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "classes"
            ],
            "additionalProperties": false
          },
          "expected": {},
          "approval_requirement": {
            "enum": [
              "explicit_owner",
              "exact_owner",
              "none"
            ]
          },
          "enforcement": {
            "type": "object",
            "properties": {
              "mechanism": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mechanism"
            ],
            "additionalProperties": false
          },
          "source_sections": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "primitive",
          "scope",
          "level",
          "applicability",
          "expected",
          "approval_requirement",
          "enforcement",
          "source_sections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "domain",
    "rules"
  ],
  "additionalProperties": false
}
