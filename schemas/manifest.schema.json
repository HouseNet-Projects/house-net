{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.3.0"
    },
    "effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
      "const": "HouseNet-Projects"
    },
    "github_identity": {
      "const": "HouseNet-Projects"
    },
    "namespace": {
      "const": "HouseNet-Projects"
    },
    "classification": {
      "const": "A"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "const": "a15b6b22aeecc7beaaf2f13e9de20e45b1a49be24c6ba280a5b3ac364f034491"
        },
        "external_original_path": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "external_original_path",
        "semantics"
      ],
      "additionalProperties": false
    },
    "canonical_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "file_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "section",
          "source_sha256",
          "rule_ids"
        ],
        "additionalProperties": false
      }
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "authority",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "supplemental_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1}
        },
        "required": ["id", "authority", "decision"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "effective_date",
    "owner",
    "github_identity",
    "namespace",
    "classification",
    "source",
    "canonical_files",
    "file_sha256",
    "coverage",
    "amendments"
  ],
  "additionalProperties": false
}
