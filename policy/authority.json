      "primitive": "operation.destructive",
      "scope": "repository",
      "level": "MANDATORY",
      "applicability": {
        "classes": [
          "A",
          "B",
          "C"
        ]
      },
      "expected": {
        "requires": "exact_owner_approval",
        "actions": [
          "repository_delete",
          "repository_archive",
          "important_branch_delete",
          "force_push",
          "shared_history_rewrite",
          "visibility_change",
          "credential_change",
          "authentication_change",
          "token_create_or_revoke",
          "secret_rotate_or_remove",
          "destructive_migration",
          "release_or_tag_delete",
          "destructive_environment_change"
