  "amendments": [
    {
      "id": "MISSION-1.0-ACTIONS",
      "authority": "Owner mission section 1",
      "decision": "Read-only access to official/trusted external action repositories and documentation is allowed only for necessary dependency resolution and security due diligence; external mutations remain prohibited."
    },
    {
      "id": "DOC-HUMAN-VISIBLE-BILINGUAL-1.1",
      "authority": "OWNER-POLICY-UPDATE-2026-09-15",
      "decision": "Human-facing HouseNet artifacts must contain materially equivalent English and Armenian content; machine and agent artifacts may remain English-only."
    },
    {
      "id": "VERSION-SINGLE-SOURCE-UNIVERSAL-1.2",
      "authority": "OWNER-POLICY-UPDATE-2026-09-15",
      "decision": "Every versioned HouseNet entity has one registered machine-readable version authority; registered derived surfaces must remain synchronized and drift fails validation."
    },
    {
      "id": "MIGRATION-AI-NEUTRAL-1.3",
      "authority": "OWNER-MISSION-UNIVERSAL-ENGINEERING-MIGRATION-2026-09-15",
      "decision": "HouseNet governance is agent-neutral; build-time agents must not create unapproved runtime provider dependencies, and legacy adoption is staged with source-of-truth evidence."
    }
  ],
  "supplemental_rules": [
    {
      "id": "HN-DOC-HUMAN-VISIBLE-BILINGUAL",
      "authority": "OWNER-POLICY-UPDATE-2026-09-15",
      "decision": "Mandatory bilingual contract for human-facing content across repository classes A, B and C."
    },
    {
      "id": "HN-VERSION-SINGLE-SOURCE",
      "authority": "OWNER-POLICY-UPDATE-2026-09-15",
      "decision": "Universal single-source version authority and deterministic drift enforcement for versioned HouseNet entities."
    },
    {
      "id": "HN-ARCH-AI-PROVIDER-INDEPENDENCE",
      "authority": "OWNER-MISSION-UNIVERSAL-ENGINEERING-MIGRATION-2026-09-15",
      "decision": "Build-time agent use does not justify an unregistered runtime AI-provider dependency."
    },
    {
      "id": "HN-MIGRATION-STAGED-ADOPTION",
      "authority": "OWNER-MISSION-UNIVERSAL-ENGINEERING-MIGRATION-2026-09-15",
      "decision": "Legacy projects pass staged discovery, quarantine, audit, proposal, approval, migration and certification states before canonicalization."
    },
    {
      "id": "HN-DATA-CLASSIFICATION",
      "authority": "OWNER-MISSION-UNIVERSAL-ENGINEERING-MIGRATION-2026-09-15",
      "decision": "Operational class and independent data classification are both recorded; unknown sensitivity requires owner decision."
    },
    {
      "id": "HN-SOURCE-OF-TRUTH",
      "authority": "OWNER-MISSION-UNIVERSAL-ENGINEERING-MIGRATION-2026-09-15",
      "decision": "Conflicting source candidates block canonicalization and legacy evidence is preserved."
    },
    {
      "id": "HN-DESIGN-SYSTEM-ADOPTION",
      "authority": "OWNER-ZERO-TRUST-FINAL-HARDENING-2026-09-15",
      "decision": "Every canonical HouseNet repository declares and validates its Design System release, visual category, approved asset source, bilingual README/document contract and social-preview state."
    },
    {
      "id": "HN-PERSON-INDEPENDENT-AUTHORITY",
      "authority": "OWNER-ZERO-TRUST-FINAL-HARDENING-2026-09-15",
      "decision": "Machine authority uses stable HouseNet owner/principal roles; human display names and historical evidence remain allowed."
    }
  ],
