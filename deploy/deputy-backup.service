[Unit]
Description=HouseNet Deputy durable backup
[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@/command-center
EnvironmentFile=-@ENV@
Environment=DEPUTY_BACKUP_DIR=@BACKUP@
ExecStart=@VENV@/bin/python -c "import backup_ops; print(backup_ops.backup())"
NoNewPrivileges=true
PrivateTmp=true
