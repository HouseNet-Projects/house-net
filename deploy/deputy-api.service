[Unit]
Description=HouseNet Deputy operator API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/command-center
EnvironmentFile=-@ENV@
Environment=DEPUTY_BIND=@BIND@
Environment=DEPUTY_PORT=@PORT@
ExecStart=@VENV@/bin/python product_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
