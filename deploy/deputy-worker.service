[Unit]
Description=HouseNet Deputy proactive worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/command-center
EnvironmentFile=-@ENV@
Environment=DEPUTY_WORKER_INTERVAL=@INTERVAL@
ExecStart=@VENV@/bin/python worker.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
